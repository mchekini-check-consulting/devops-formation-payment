# NO shebang lines — husky v9+ injects the shell automatically

z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    # Deletion push — nothing to lint
    if [ "$local_sha" = "$z40" ]; then
        continue
    fi

    if [ "$remote_sha" = "$z40" ]; then
        # New branch: lint commits not yet on main
        base=$(git merge-base HEAD main 2>/dev/null)
        if [ -z "$base" ]; then
            echo "⚠️  Impossible de trouver la base commune avec main, skip lint"
            continue
        fi
        from="$base"
        to="$local_sha"
    else
        # Existing branch: lint only new commits
        from="$remote_sha"
        to="$local_sha"
    fi

    echo "🔍 Vérification des commits: $from..$to"
    npx commitlint --from "$from" --to "$to"

    if [ $? -ne 0 ]; then
        echo "❌ Les commits ne respectent pas les règles commitlint"
        exit 1
    fi
done

exit 0