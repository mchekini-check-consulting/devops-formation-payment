#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Récupérer les arguments du push
z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = $z40 ]; then
        # Suppression, on ignore
        continue
    fi
    
    if [ "$remote_sha" = $z40 ]; then
        # Nouvelle branche : vérifier uniquement les commits depuis main
        # Utiliser git merge-base pour trouver la base commune
        base=$(git merge-base HEAD main 2>/dev/null || echo "main")
        range="$base..$local_sha"
    else
        # Branche existante : uniquement les nouveaux commits
        range="$remote_sha..$local_sha"
    fi
    
    # Vérifier les commits avec commitlint
    if [ -n "$range" ]; then
        echo "🔍 Vérification des commits: $range"
        npx commitlint --from "$range"
        if [ $? -ne 0 ]; then
            echo "❌ Les commits ne respectent pas les règles commitlint"
            exit 1
        fi
    fi
done

exit 0